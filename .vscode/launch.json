{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug items in the shell (gateway)",
      "detail": "Stop the container first: `make mfe-dev s=items` in rmu-platform",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost/items",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "start:live",
      "sourceMapPathOverrides": {
        "webpack://items/./*": "${workspaceFolder}/*"
      }
    },
    {
      "name": "Debug items standalone (:8088)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8088",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "start:live",
      "sourceMapPathOverrides": {
        "webpack://items/./*": "${workspaceFolder}/*"
      }
    }
  ]
}
